{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "command": {
          "anyOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ]
        }
      }
    },
    "common": {
      "type": "object",
      "properties": {
        "extraVolumes": { "type": "array", "items": { "type": "object" } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["maxSkew", "topologyKey", "whenUnsatisfiable", "labelSelector"],
            "properties": {
              "maxSkew": { "type": "integer", "minimum": 1 },
              "topologyKey": { "type": "string", "minLength": 1 },
              "whenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] },
              "labelSelector": { "type": "object" },
              "matchLabelKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "minDomains": { "type": "integer", "minimum": 1 },
              "nodeAffinityPolicy": { "enum": ["Honor", "Ignore"] },
              "nodeTaintsPolicy": { "enum": ["Honor", "Ignore"] }
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "description": "Kubernetes terminationGracePeriodSeconds. The process SIGKILLs after this window; SHUTDOWN_TIMEOUT_SECONDS must stay strictly below it."
        },
        "shutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "Bounded graceful-shutdown deadline (seconds). Injected as SHUTDOWN_TIMEOUT_SECONDS and is the single source for that variable. The schema only validates the type and a soft upper bound; the chart fails at template time if this value is greater than or equal to common.terminationGracePeriodSeconds (default 30), which JSON Schema cannot enforce dynamically. Because the value is rendered as an explicit env entry, an external envFrom ConfigMap/Secret cannot override it at runtime."
        }
      }
    },
    "serve": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "autoscaling": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
            "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
            "behavior": { "type": "object" },
            "additionalMetrics": { "type": "array", "items": { "type": "object" } }
          }
        },
        "extraVolumes": { "type": "array", "items": { "type": "object" } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object" } }
      }
    },
    "control": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "const": 1 },
        "extraVolumes": { "type": "array", "items": { "type": "object" } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
        "resumeVolume": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "mountPath": { "type": "string" },
            "persistentVolumeClaim": { "type": "string" }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "hookWeight", "hookDeletePolicy", "backoffLimit", "activeDeadlineSeconds", "ttlSecondsAfterFinished", "serviceAccountName", "env", "envFrom", "extraEnv", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "hookWeight": { "type": "integer" },
        "hookDeletePolicy": { "type": "string", "minLength": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "serviceAccountName": { "type": "string" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "env": { "type": "object" },
        "envFrom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configMaps", "secrets"],
          "properties": {
            "configMaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "secrets": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "resources": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serve", "control"],
      "properties": {
        "serve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "$ref": "#/$defs/nonNegativeIntOrPercent" }
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "maxUnavailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": { "$ref": "#/$defs/nonNegativeIntOrPercent" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "array", "items": { "type": "object" } },
        "egress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "className": { "type": "string", "minLength": 1 },
        "public": { "$ref": "#/$defs/ingress" },
        "control": { "$ref": "#/$defs/ingress" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "serve": {
            "properties": { "autoscaling": { "properties": { "enabled": { "const": true } } } }
          }
        }
      },
      "then": {
        "properties": {
          "serve": {
            "properties": {
              "autoscaling": {
                "properties": {
                  "maxReplicas": { "minimum": 2 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "networkPolicy": {
            "properties": { "enabled": { "const": true } }
          }
        }
      },
      "then": {
        "properties": {
          "networkPolicy": {
            "properties": {
              "ingress": { "minItems": 1 },
              "egress": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "podDisruptionBudget": {
            "properties": {
              "serve": { "properties": { "enabled": { "const": true } } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "podDisruptionBudget": {
            "properties": {
              "serve": {
                "properties": {
                  "minAvailable": {
                    "anyOf": [
                      { "type": "integer", "minimum": 1 },
                      { "type": "string", "pattern": "^([0-9]|[1-9][0-9]*)%$" }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "podDisruptionBudget": {
            "properties": {
              "control": { "properties": { "enabled": { "const": true } } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "podDisruptionBudget": {
            "properties": {
              "control": {
                "properties": {
                  "maxUnavailable": { "const": 0 }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonNegativeIntOrPercent": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+%$" }
      ]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          },
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "secretName": { "minLength": 1 } }, "required": ["secretName"] }
        }
      }
    }
  }
}
