{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlerts"
  ],
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/|\\.)compose[^/]*\\.ya?ml$/",
      "/(^|/|\\.)docker-compose[^/]*\\.ya?ml$/",
      "/^deploy/compose/dev-compose\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "constraintsFiltering": "strict"
    },
    {
      "matchManagers": ["gomod", "dockerfile", "docker-compose", "mise", "github-actions"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["gomod", "dockerfile", "docker-compose", "mise", "github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "platformAutomerge": true
    },
    {
      "matchManagers": ["gomod", "dockerfile", "docker-compose", "mise", "github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "The chart's default image is a placeholder; deployed images and tags are pinned in sekai-k3s-infra.",
      "matchManagers": ["helm-values"],
      "matchFileNames": ["deploy/helm/sekai-master-api/values.yaml"],
      "matchPackageNames": ["sekai-master-api"],
      "enabled": false
    },
    {
      "description": "swaggo/files v2 only exports an fs.FS, while gin-swagger v1.6.1 still requires the v1 webdav handler.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/swaggo/files"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
